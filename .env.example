# Default AI model: Google MedGemma 1.5 4B (open weights) served via local vLLM
IMAGING_MODEL=google/medgemma-1.5-4b-it
IMAGING_MODEL_URL=http://127.0.0.1:8000/v1/chat/completions
# Optional bearer token if vLLM is launched with --api-key
IMAGING_MODEL_KEY=
# Adapter mode: auto | medgemma | point (auto enables MedGemma box_2d -> point conversion)
IMAGING_ADAPTER=auto
# Schema enforcement mode: response_format | guided_json | none
IMAGING_SCHEMA_MODE=response_format
# Optional output token limit (256-4096)
IMAGING_MAX_TOKENS=1200
# Required by vLLM to download gated Google MedGemma 1.5 weights from Hugging Face
HF_TOKEN=
